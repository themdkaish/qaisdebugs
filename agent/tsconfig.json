{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useUnknownInCatchVariables": false,
    "declaration": false,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "../dist/agent"
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
